{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Xclense",
  "version": "0.1.0",
  "identifier": "com.xclense.app",
  "build": {
    "beforeDevCommand": "yarn dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "yarn build",
    "frontendDist": "../.next"
  },
  "app": {
    "windows": [
      {
        "title": "Xclense",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
